# Dify AI助手配置模板
# 复制此文件为 .env 并填入真实的配置

# ==================== 前端配置 ====================
# 用于VitePress构建，注入到前端页面

# VITE_DIFY_TOKEN: 应用的 App Token
# 获取方式：Dify 控制台 -> 应用 -> API访问 -> App Token（以 app- 开头）
# 注意：App Token 比 API Key 更安全，因为可以配置域名白名单
VITE_DIFY_TOKEN=

# 是否启用 Dify AI 助手
VITE_DIFY_ENABLED=true

# ==================== 后端配置 ====================
# 用于同步脚本（sync-to-dify.mjs），不会暴露到前端

# DIFY_API_KEY: 知识库的 API 密钥（注意：与应用 Token 不同）
# 获取方式：Dify 控制台 -> 知识库 -> API 密钥，以 dataset- 开头
# 若误填 app- 开头的应用 Token，脚本会直接报错退出
DIFY_API_KEY=

# DIFY_DATASET_ID: 知识库的 ID
# 获取方式：打开知识库页面，URL 中的 ID 部分
# 例如 https://cloud.dify.ai/datasets/<这段就是 ID>/documents
DIFY_DATASET_ID=

# DIFY_BASE_URL: 可选，默认 https://api.dify.ai/v1
DIFY_BASE_URL=https://api.dify.ai/v1

# DIFY_THROTTLE_MS: 可选，请求间隔毫秒，默认 6500（约 9 次/分钟）
# Dify 免费版限制 10 次知识库请求/分钟，调小可能触发临时限流
DIFY_THROTTLE_MS=6500
